# Copy this file to .env and fill in real values before running the app.

# Flask session signing key - use a long random string in production.
SECRET_KEY=change-me-to-something-random

# PostgreSQL connection string: postgresql+psycopg2://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+psycopg2://fitquest:fitquest@localhost:5432/fitquest
